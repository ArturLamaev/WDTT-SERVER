# =============================================================================
# WDTT-SERVER — переменные docker compose. Скопируйте в .env и впишите секреты.
#     cp .env.example .env
# Все сгенерированные пароли печатаются в логи при первом старте:
#     docker compose logs wdtt | grep -i -E 'password|path|host'
# =============================================================================

# ── Панель (nginx + HTTPS) ─────────────────────────────────────────────────
# Логин администратора панели
PANEL_USER=admin
# Пароль панели. Пусто = сгенерируется случайный (появится в логах при первом старте)
PANEL_PASSWORD=
# Секретный URL-путь панели (16-80 [A-Za-z0-9_-]). Пусто = случайный (в логах)
PANEL_PATH=
# Домен или публичный IPv4 панели. Пусто = авто-определение публичного IP
PANEL_HOST=
# Внешний HTTPS-порт панели (nginx). Откройте его на VPS
PANEL_HTTPS_PORT=9999
# Email для Let's Encrypt (нужен при TLS_MODE=letsencrypt)
PANEL_EMAIL=
# self-signed (по умолчанию) | letsencrypt (нужны PANEL_HOST-домен и открытый :80)
TLS_MODE=self-signed

# ── Ядро qWDTT ─────────────────────────────────────────────────────────────
# Главный пароль ядра (для Android-приложения / клиентов). Пусто = случайный (в логах)
WDTT_MAIN_PASSWORD=
WDTT_DTLS_PORT=56000
WDTT_WG_PORT=56001
WDTT_ADMIN_PORT=56002     # admin API ядра — наружу НЕ публиковать!
WDTT_DNS=1.1.1.1,1.0.0.1
# Экспериментальные порты ядра (пусто = выключено)
# WDTT_DIRECT_PORT=9000
# WDTT_RAW_PORT=

# ── Telegram-бот ядра (опционально) ────────────────────────────────────────
# WDTT_TELEGRAM_BOT_TOKEN=123456:ABC...
# WDTT_TELEGRAM_ADMIN_ID=123456789

# ── Docker / обслуживание ──────────────────────────────────────────────────
TZ=UTC
# Авто-перезапуск ядра и панели каждые N часов (0 = выключить), аналог
# wdtt-auto-restart.timer из оригинальной установки
AUTO_RESTART_HOURS=6
# Скачивать Xray Core и wgcf (WARP) при старте, если их нет в volume (1/0)
WDTT_FETCH_RUNTIME=1
# База для сборки образа: ubuntu:24.04 (по умолчанию) или debian:13
# WDTT_BASE_IMAGE=ubuntu:24.04