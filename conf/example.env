# WDTT-SERVER — пример переменных для установки
# cp conf/example.env /tmp/wdtt.env && set -a && . /tmp/wdtt.env && set +a
# затем: sudo -E ./install.sh --non-interactive

# Панель (nginx + HTTPS)
PANEL_USER=admin
PANEL_PASSWORD='смени-меня-на-длинный-пароль'
PANEL_PATH=/secret
PANEL_HOST=panel.example.com
PANEL_HTTPS_PORT=8443
PANEL_EMAIL=you@example.com

# Ядро qWDTT (главный пароль доступа)
WDTT_MAIN_PASSWORD='смени-меня-12-64'
# WDTT_SOURCE_DIR=/путь/к/локальному/форку/wdtt  # при желании свой каталог

# Telegram-бот ядра (опционально)
# WDTT_TELEGRAM_BOT_TOKEN=123456:ABC...
# WDTT_TELEGRAM_ADMIN_ID=123456789

# Сборка
GO_VERSION=1.25.0